{
  "name": "@gkucmierz/nano-ui",
  "version": "1.8.27",
  "license": "ISC",
  "author": "Grzegorz Kućmierz",
  "description": "High-performance, minimal footprint Vue 3 UI library, interactive 3D charts, and directives.",
  "type": "module",
  "main": "./dist/nano-ui.js",
  "module": "./dist/nano-ui.js",
  "exports": {
    ".": {
      "import": "./dist/nano-ui.js"
    },
    "./vite": {
      "import": "./dist/vite.js"
    },
    "./parsers": {
      "import": "./dist/parsers/index.js"
    },
    "./parsers/*": {
      "import": "./dist/parsers/*.js"
    },
    "./style.css": "./dist/nano-ui.css",
    "./nano-ui.css": "./dist/nano-ui.css",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --mode app --port 33164",
    "prebuild": "npm run test:unit && node scripts/generate-icons.mjs",
    "build": "vite build",
    "prebuild:app": "npm run test:unit && node scripts/generate-icons.mjs",
    "build:app": "vite build --mode app",
    "prebuild:ssg": "npm run test:unit && node scripts/generate-icons.mjs",
    "build:ssg": "vite build --mode ssg && node scripts/prerender.mjs",
    "prepublishOnly": "npm run test:unit && npm run build",
    "preview:app": "vite preview --outDir dist-app --port 33164",
    "preview:ssg": "vite preview --outDir dist-ssg --port 33164",
    "serve:ssg": "npm run build:ssg && npm run preview:ssg",
    "prerender": "node scripts/prerender.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:verbose": "eslint . && echo '✨ ESLint: 0 errors, all clean!'",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@gkucmierz/analytics": "^1.0.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "^10.1.0",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.469.0",
    "minisearch": "^7.1.2",
    "vite": "^8.0.12",
    "vue": "^3.4.0",
    "vue-minisearch": "^1.0.0",
    "vue-router": "^5.0.6",
    "vue-url-cleaner": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://gitea.7u.pl/gkucmierz/nano-ui.git"
  },
  "homepage": "https://gitea.7u.pl/gkucmierz/nano-ui",
  "keywords": [
    "vue",
    "ui",
    "components",
    "directives",
    "ripple",
    "nano",
    "glassmorphism",
    "chart",
    "donut-chart",
    "pie-chart",
    "3d-chart",
    "svg-chart",
    "interactive-charts",
    "scrubber",
    "precision-scrubber",
    "high-precision",
    "slider",
    "jog-dial"
  ]
}
